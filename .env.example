# Notion の記事データベース連携（未設定の場合はサンプル記事で表示）
# インテグレーションのトークン: https://www.notion.so/profile/integrations で作成し、記事データベースに「接続」を追加する
NOTION_TOKEN=
# 記事データベースのデータソース ID（データベースの「…」→「データソースを管理」→ ID をコピー）
NOTION_DATA_SOURCE_ID=

# Notion 更新の即時反映用（/api/revalidate の認証）。長いランダム文字列を設定する
REVALIDATE_SECRET=

# 検索エンジンへの掲載（正式公開時に true にする。未設定なら noindex）
SITE_INDEXABLE=
